  "memories": [
    {
      "id": "mem-1",
      "date": "2021-10-30",
      "title": "第一章 · 那天风有点凉",
      "place": "北京 · 五道口",
      "body": "第一次约你出来吃饭，你穿了件米色的外套。饭后在街上走了很久，聊到末班地铁都快没了。后来你说那天你其实很紧张，我说我也是——这句话憋了三年才告诉你。",
      "photo": "",
      "scene": "city",
      "weather": "晴 · 8℃"
    },
    {
      "id": "mem-2",
      "date": "2022-04-16",
      "title": "第二章 · 第一次两个人出门",
      "place": "杭州 · 西湖",
      "body": "四月的柳絮落了一肩。我们租了两条船，你说要比赛，结果两只船一直撞在一起。傍晚在楼外楼吃了一顿很贵的饭，你说下次换你请。",
      "photo": "",
      "scene": "lake",
      "weather": "多云 · 19℃"
    },
    {
      "id": "mem-3",
      "date": "2022-10-30",
      "title": "第三章 · 一周年",
      "place": "上海 · 外滩",
      "body": "一周年。你从包里掏出一本相册，里面是我们这一年的所有照片，最后一张写着「还要很多年」。江风很冷，我们把手揣在同一个口袋里。",
      "photo": "",
      "scene": "night",
      "weather": "晴 · 16℃"
    },
    {
      "id": "mem-4",
      "date": "2023-05-01",
      "title": "第四章 · 辣到说不出话",
      "place": "成都 · 玉林路",
      "body": "火锅吃到一半你就去灌了三杯豆奶，还是不肯认输。下午去看熊猫，它们在树上睡得四仰八叉，你说真羡慕。小酒馆门口排了很长的队，我们没进去，坐在马路边听了一首《成都》。",
      "photo": "",
      "scene": "food",
      "weather": "阴 · 24℃"
    },
    {
      "id": "mem-5",
      "date": "2023-10-01",
      "title": "第五章 · 城墙上的一圈",
      "place": "西安 · 明城墙",
      "body": "租了双人自行车，我骑得歪歪扭扭，你在后面一直笑。十三公里一圈，骑到一半下起了小雨，我们停在城楼下面躲雨，买了两个肉夹馍分着吃。",
      "photo": "",
      "scene": "town",
      "weather": "小雨 · 17℃"
    },
    {
      "id": "mem-6",
      "date": "2024-04-05",
      "title": "第六章 · 什么都没做的一下午",
      "place": "大理 · 洱海",
      "body": "那天我们什么景点都没去。搬两把椅子坐在洱海边，看云从苍山那边过来。你说这样的下午可以再来一百个。我说记下了，第一百个我们再回来。",
      "photo": "",
      "scene": "lake",
      "weather": "晴 · 21℃"
    },
    {
      "id": "mem-7",
      "date": "2024-10-02",
      "title": "第七章 · 环岛路的日落",
      "place": "厦门 · 环岛路",
      "body": "租了电动车沿着海岸线一直开，风把头发吹得乱七八糟。太阳落下去只用了三分钟，我们却站在那里看了很久。晚上在沙坡尾吃沙茶面，汤汁溅到你白裙子上，你至今没原谅我。",
      "photo": "",
      "scene": "sea",
      "weather": "晴 · 26℃"
    },
    {
      "id": "mem-8",
      "date": "2025-07-20",
      "title": "第八章 · 第一次一起看海",
      "place": "青岛 · 八大关",
      "body": "你光着脚往水里跑，浪打上来把裤脚全打湿了。晚上在台东吃烧烤，老板问我们结婚了没，你说还没，然后看了我一眼。那天回去的路上你一直没说话。",
      "photo": "",
      "scene": "sea",
      "weather": "晴 · 28℃"
    },
    {
      "id": "mem-9",
      "date": "2026-01-02",
      "title": "第九章 · 零下二十度",
      "place": "哈尔滨 · 中央大街",
      "body": "睫毛上结了霜，你说我们像两个移动的汤圆。在冰雪大世界排队排了四十分钟，进门的那一刻你「哇」了一声——那一声我录下来了，现在还存着。",
      "photo": "",
      "scene": "snow",
      "weather": "雪 · -21℃"
    }
  ],
